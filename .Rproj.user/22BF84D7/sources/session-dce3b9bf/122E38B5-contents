#adding new variables with mutute, specify the name of the new variable what is that variable going to store
#We do flight <- to store the new variable back in flights 
flights<- mutate(flights, gain=arr_delay-dep_delay, gainh= gain/60)
select(flights, gain, gainh)
#Mutate will add those new columns at the end (right) of your dataset 
#You can specify where you want to add those varibles with .before and .after
# it would look like mutate(flights, gain=arr, .before= arr_delay)

#Using the pipe:think of it as a chain and taking the result prom the previous step and pass it to the next one 
#it doesnt store the results from each step it just saves it to continue with the next step

flights |> #start with the dataset flights
  select(contains("delay")) |>  #from the data set select and keep all columns that contain the word "delay" in it
  mutate(dep_delay_hour= dep_delay/60) |> #Create a new column converting departure delay in hours and puts it at the end 
  arrange(dep_delay_hour)|> #reorders rows by ascending order of the departure delays hours
  head(n=4) #Returns the first 4 rows 

